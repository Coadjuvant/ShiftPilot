DB_USER=admin
DB_PASSWORD=changeme
DB_NAME=shiftpilot_db

APP_ENV=dev
AUTH_BACKEND=postgres
DATABASE_URL=postgresql://admin:changeme@db:5432/shiftpilot_db
# Compose runtime requires an already migrated database and a restricted role.
# Keep DB_USER/DB_PASSWORD for the separate maintenance service; after provisioning,
# DATABASE_URL must use that new role and its independently generated password.
DB_INITIALIZE_ON_STARTUP=false
RUNTIME_DB_USER=shiftpilot_runtime
# Supply privately when running the provisioning maintenance command.
RUNTIME_DB_PASSWORD=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=8

ADMIN_USER=admin
ADMIN_PASS=admin
ADMIN_LICENSE=DEMO

CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173
GEOIP_API_URL=
GEOIP_API_TIMEOUT=2.0
GEOIP_CACHE_TTL=3600

VITE_API_URL=/api
VITE_APP_BUILD=local
VITE_APP_VERSION=dev
VITE_GIT_COMMIT=
